# Copy to .env for local overrides (never commit .env).
# On Railway: Variables tab → set the same keys (build-time for VITE_*).

# Public asset base path. Use "/" on Railway (root of the service domain).
VITE_BASE=/

# Optional: only used by `npm start` (serve package / nixpacks fallback).
# Railway injects PORT automatically for Docker/Caddy.
# PORT=3000
